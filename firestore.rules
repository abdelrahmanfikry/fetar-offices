rules_version = '2';
// النسخة العالمية: كل مكتب داتا لوحده تحت offices/{oid} · الدخول بكود · محدش يشوف مكتب مش عضو فيه
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function isMemberOf(oid) { return signedIn() && exists(/databases/$(database)/documents/offices/$(oid)/users/$(request.auth.uid)); }

    // البروفايل العام: الاسم وقايمة المكاتب — صاحبه بس
    match /gusers/{uid} {
      allow read, write: if isMe(uid);
    }

    // الأكواد: تتقري بالكود بس (مفيش list)، وتتعمل مع المكتب
    match /codes/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && getAfter(/databases/$(database)/documents/offices/$(request.resource.data.oid)).data.createdBy == request.auth.uid
                    && getAfter(/databases/$(database)/documents/offices/$(request.resource.data.oid)).data.code == code;
    }

    // قراءة كل أصناف المكتب مرة واحدة (collectionGroup مع officeId)
    match /{path=**}/items/{itemId} {
      allow read: if isMemberOf(resource.data.officeId);
    }

    match /offices/{oid} {
      function mem() { return isMemberOf(oid); }
      function cfg() { return /databases/$(database)/documents/offices/$(oid)/config/app; }
      function isAdmin() { return mem() && exists(cfg()) && request.auth.uid in get(cfg()).data.admins; }
      function orderOpen(orderId) { return get(/databases/$(database)/documents/offices/$(oid)/orders/$(orderId)).data.status == 'open'; }
      function validItem(d) { return d.name is string && d.name.size() > 0 && d.qty is number && d.qty > 0 && d.price is number && d.price >= 0; }

      allow read: if mem();
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid && request.resource.data.code is string && request.resource.data.code.size() >= 6;
      allow update: if isAdmin() && request.resource.data.code == resource.data.code && request.resource.data.createdBy == resource.data.createdBy;

      // المستخدمين: كل واحد يعدّل بروفايله بس
      match /users/{uid} {
        allow read: if mem();
        // الانضمام: لازم الكود الصح · بعدها كل واحد يعدّل نفسه بس
        allow create: if isMe(uid) && request.resource.data.code == getAfter(/databases/$(database)/documents/offices/$(oid)).data.code;
        allow update: if isMe(uid);
      }

      // الإعدادات: أول واحد بيعمل نفسه أدمن، وبعدها الأدمن بس يعدّل
      match /config/app {
        allow read: if mem();
        allow create: if signedIn() && request.resource.data.admins == [request.auth.uid]
                      && getAfter(/databases/$(database)/documents/offices/$(oid)).data.createdBy == request.auth.uid;
        allow update: if isAdmin();
      }

      // الأصناف الثابتة: مشتركة، أي حد يعدّلها
      match /config/catalog {
        allow read, write: if mem();
      }

      // الأرصدة المرحّلة بعد التنظيف — الأدمن بس
      match /carry/{id} {
        allow read: if mem();
        allow write: if isAdmin();
      }

      // الطلبيات: اللي عملها أو اللي بيدفع يديرها · المسح للأدمن بس (التنظيف)
      match /orders/{orderId} {
        allow read: if mem();
        allow create: if mem() && request.resource.data.createdBy == request.auth.uid && request.resource.data.status == 'open';
        allow update: if mem() && request.resource.data.createdBy == resource.data.createdBy
                      && (resource.data.createdBy == request.auth.uid || resource.data.payerUid == request.auth.uid
                          // عجلة الحظ: أي حد يلفها ويسجّل مين هينزل (الحقول دي بس)
                          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['runnerUid', 'runnerLine', 'runnerAt', 'runnerSpins']));
        allow delete: if isAdmin();

        // الأصناف: كل واحد طلبه بس، وطول ما الطلبية مفتوحة
        match /items/{itemId} {
          allow create: if mem() && isMe(request.resource.data.uid) && request.resource.data.officeId == oid && validItem(request.resource.data) && orderOpen(orderId);
          allow update: if isMe(resource.data.uid) && request.resource.data.uid == resource.data.uid
                        && validItem(request.resource.data) && orderOpen(orderId);
          allow delete: if (isMe(resource.data.uid) && orderOpen(orderId)) || isAdmin();
        }

        // الملاحظات: أي حد يضيف، صاحبها أو الأدمن يمسح
        match /notes/{noteId} {
          allow read: if mem();
          allow create: if mem() && isMe(request.resource.data.uid) && request.resource.data.text is string && request.resource.data.text.size() > 0;
          allow delete: if isMe(resource.data.uid) || isAdmin();
        }
      }

      // صندوق الشكاوى: النص للكل من غير اسم · الكاتب في مجموعة منفصلة الأدمن بس يقراها
      match /complaints/{cid} {
        allow read: if mem();
        allow create: if mem() && request.resource.data.keys().hasOnly(['text', 'at'])
                      && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 200;
        allow delete: if isAdmin() || (exists(/databases/$(database)/documents/offices/$(oid)/complaintAuthors/$(cid))
                      && get(/databases/$(database)/documents/offices/$(oid)/complaintAuthors/$(cid)).data.uid == request.auth.uid);
      }
      match /complaintAuthors/{cid} {
        allow read: if isAdmin() || (mem() && resource.data.uid == request.auth.uid);
        allow create: if mem() && isMe(request.resource.data.uid) && request.resource.data.keys().hasOnly(['uid']);
        allow delete: if isAdmin() || isMe(resource.data.uid);
      }


      // التحويلات: اللي حوّل يسجّل · اللي استلم بس يأكد · المسح قبل التأكيد أو للأدمن
      match /transfers/{tid} {
        allow read: if mem();
        allow create: if mem() && isMe(request.resource.data.fromUid) && request.resource.data.confirmed == false
                      && request.resource.data.amount is number && request.resource.data.amount > 0
                      && request.resource.data.toUid != request.auth.uid;
        // المستلم: يأكد «وصلني» أو يقول «موصلش» (بيفضل ظاهر للكل) · المحوّل: «والله حوّلت» يرجّعه للتأكيد
        allow update: if resource.data.confirmed == false && (
                        (isMe(resource.data.toUid)
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['confirmed', 'confirmedAt', 'rejected', 'rejectedAt'])
                          && (request.resource.data.confirmed == true || request.resource.data.rejected == true))
                     || (isMe(resource.data.fromUid)
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rejected', 'rejectedAt'])
                          && request.resource.data.rejected == false));
        allow delete: if ((isMe(resource.data.fromUid) || isMe(resource.data.toUid)) && resource.data.confirmed == false) || isAdmin();
      }

      // المنيوهات: مشتركة للكل · المسح لصاحبها
      match /restaurants/{rid} {
        allow read, create, update: if mem();
        allow delete: if isMe(resource.data.createdBy) || isAdmin();
      }
    }
  }
}
